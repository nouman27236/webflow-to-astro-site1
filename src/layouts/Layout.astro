---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteUrl = 'https://testing-astro-27236.netlify.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/images/hero-office.webp', siteUrl);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Dentist', 'LocalBusiness'],
  name: 'Contemporary Dentistry PLLC',
  alternateName: 'Dentistry With A Heart',
  url: 'https://www.dentistrywithaheart.com',
  telephone: '(585) 244-3337',
  email: 'info@dentistrywithaheart.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2052 S Clinton Ave',
    addressLocality: 'Rochester',
    addressRegion: 'NY',
    postalCode: '14618',
    addressCountry: 'US',
  },
  openingHours: ['Mo-Fr 07:30-16:30'],
  description:
    "Contemporary Dentistry PLLC, known as 'Dentistry With A Heart,' is a holistic and biologic dental practice in Rochester, NY, combining advanced technology with genuine, compassionate care. The team offers comprehensive general, cosmetic, restorative, and holistic dentistry using biocompatible, non-allergenic materials in a calm, wellness-focused environment.",
  isAcceptingNewPatients: true,
  serviceArea: [
    { '@type': 'AdministrativeArea', name: 'Rochester' },
    { '@type': 'AdministrativeArea', name: 'Monroe County' },
  ],
  employee: [
    { '@type': 'Person', name: 'Dr. Anna Belous', jobTitle: 'Dentist, DDS' },
    { '@type': 'Person', name: 'Dr. Adriana Palacio', jobTitle: 'Dentist, DDS' },
    { '@type': 'Person', name: 'Dr. Robert Calcagno', jobTitle: 'Dentist, DDS, FADI, FICD' },
  ],
  image: ogImage.toString(),
  logo: new URL('/images/logo.svg', siteUrl).toString(),
  sameAs: [
    'https://www.facebook.com/ContemporaryDentistryRochester/',
    'https://www.instagram.com/contemporarydentistryroc/',
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    reviewCount: '1',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-white text-slate-800 font-body antialiased">
    <slot />
  </body>
</html>

---
const navLinks = [
  { label: 'Home', href: '/', dropdown: false },
  { label: 'About Us', href: '/about-us', dropdown: true },
  { label: 'Services', href: '/services', dropdown: true },
  { label: 'Patient Info', href: '/patient-information', dropdown: true },
  { label: 'Patient Profiles', href: '/patient-profiles', dropdown: false },
  { label: 'Blog', href: '/blog', dropdown: false },
  { label: 'Contact Us', href: '/contact-us', dropdown: false },
];
---

<header class="sticky top-0 z-50 bg-navbg">
  <div class="mx-auto flex items-center justify-between h-[72px] px-6 lg:px-10 xl:px-[72px]">
    <a href="/" class="shrink-0">
      <img src="/images/logo.svg" alt="Contemporary Dentistry PLLC" class="h-10 w-auto" />
    </a>

    <nav class="hidden xl:flex items-center gap-0.5 font-body text-sm text-ink whitespace-nowrap">
      {navLinks.map((link) => (
        <a href={link.href} class="flex items-center gap-1 px-2 py-2 hover:text-brand transition-colors whitespace-nowrap">
          {link.label}
          {link.dropdown && (
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="opacity-70 shrink-0">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          )}
        </a>
      ))}
    </nav>

    <div class="hidden xl:flex items-center gap-3 shrink-0">
      <a
        href="/book-an-appointment"
        class="font-body text-sm font-semibold text-white bg-brand border-2 border-brand rounded-full px-5 py-2.5 hover:bg-brand-dark transition-colors whitespace-nowrap"
      >
        Request an Appointment
      </a>
      <a
        href="tel:+15852443337"
        class="font-body text-sm font-semibold text-brand border-2 border-brand rounded-full px-5 py-2.5 hover:bg-brand hover:text-white transition-colors whitespace-nowrap"
      >
        Call Us (585) 244-3337
      </a>
    </div>

    <button
      id="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      class="xl:hidden flex flex-col justify-center gap-1.5 h-10 w-10 shrink-0"
    >
      <span class="menu-line block h-0.5 w-6 bg-ink rounded transition-transform"></span>
      <span class="menu-line-2 block h-0.5 w-6 bg-ink rounded transition-opacity"></span>
      <span class="menu-line-3 block h-0.5 w-6 bg-ink rounded transition-transform"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden xl:hidden border-t border-black/5 bg-navbg">
    <nav class="flex flex-col px-6 py-4 font-body text-sm text-ink">
      {navLinks.map((link) => (
        <a href={link.href} class="py-3 border-b border-black/5 hover:text-brand transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex flex-col gap-3 px-6 pb-6">
      <a
        href="/book-an-appointment"
        class="text-center font-body text-sm font-semibold text-white bg-brand border-2 border-brand rounded-full px-5 py-2.5 hover:bg-brand-dark transition-colors"
      >
        Request an Appointment
      </a>
      <a
        href="tel:+15852443337"
        class="text-center font-body text-sm font-semibold text-brand border-2 border-brand rounded-full px-5 py-2.5 hover:bg-brand hover:text-white transition-colors"
      >
        Call Us (585) 244-3337
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.classList.toggle('is-open', isOpen);
  });
</script>

<style>
  #menu-toggle.is-open .menu-line {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-toggle.is-open .menu-line-2 {
    opacity: 0;
  }
  #menu-toggle.is-open .menu-line-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
